# --- Model: OpenRouter (remote, cheap) -------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
CLAUDEPHONE_PROVIDER=openrouter
CLAUDEPHONE_MODEL=deepseek/deepseek-v4-flash-0731

# --- Model: local llama.cpp on the phone -----------------------------------
# CLAUDEPHONE_PROVIDER=local
# CLAUDEPHONE_LOCAL_URL=http://127.0.0.1:8080/v1
# CLAUDEPHONE_LOCAL_MODEL=local
# CLAUDEPHONE_TOOL_MODE=json      # small models have no native tool calling

# --- Server ----------------------------------------------------------------
# CLAUDEPHONE_TOKEN=            # auto-generated into ~/.claudephone/token
# CLAUDEPHONE_SERIAL=           # adb serial, if more than one device

# --- Laptop bridge ---------------------------------------------------------
# CLAUDEPHONE_URL=http://192.168.1.5:8765
