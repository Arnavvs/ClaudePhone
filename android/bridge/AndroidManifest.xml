<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.claudephone.bridge"
    android:versionCode="2"
    android:versionName="0.2">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:label="ClaudePhone Bridge"
        android:icon="@android:drawable/ic_menu_compass"
        android:allowBackup="false">

        <service
            android:name=".BridgeService"
            android:exported="true"
            android:label="ClaudePhone Bridge"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Serves the HTTP auth token to adb shell / root only. Exported so the
             `content` command can reach it; TokenProvider rejects every other
             caller uid in code. See TokenProvider.java. -->
        <provider
            android:name=".TokenProvider"
            android:authorities="com.claudephone.bridge.auth"
            android:exported="true" />
    </application>
</manifest>
